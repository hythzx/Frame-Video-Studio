# By default the site is only reachable from this Docker host.
BIND_ADDRESS=127.0.0.1
PORT=8080
MAX_DURATION_SECONDS=3600
MAX_DOWNLOAD_MB=1024
# Optional: X login cookies (auth_token and ct0) to extract restricted posts.
# Format: auth_token=<value>; ct0=<value>
#TWITTER_COOKIES=
# Optional: Bilibili login cookies (SESSDATA etc.) for premium quality and better CDNs.
#BILI_COOKIES=

# Required only when using compose.deploy.yaml (prebuilt Docker Hub images).
# DOCKERHUB_USERNAME=your-dockerhub-user
# IMAGE_TAG=latest

# Required to unlock the private X Bookmarks menu (at least 20 random characters).
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FRAME_ACCESS_TOKEN=
# Completed download files are kept for this many hours before cleanup.
#FILE_TTL_HOURS=6
